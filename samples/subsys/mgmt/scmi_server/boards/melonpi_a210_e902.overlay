			 <&ap_resets A210_RESET_VO_DPU_ARST>,
			 <&ap_resets A210_RESET_VO_DPU_CRST>,
			 <&ap_resets A210_RESET_VO_DPU_HRST>,
			 <&ap_resets A210_RESET_VO_HDMI_MAIN_RST>,
			 <&ap_resets A210_RESET_VO_HDMI_PRST>,
			 <&ap_resets A210_RESET_VO_X2H0_RST>,
			 <&ap_resets A210_RESET_VO_X2H1_RST>;
	};
};

&a210_pd_top {
	status = "okay";
};

&a210_pd_gpu {
	vin-supply = <&vdd_gpu>;
	status = "okay";
};

&a210_pd_vo {
	status = "okay";
};

&a210_pd_usb {
	status = "okay";
};

&a210_pd_pcie0 {
	status = "okay";
};

&a210_pd_pcie1 {
	status = "okay";
};

&a210_pd_sata {
	status = "okay";
};

&a210_pd_emmc {
	status = "okay";
};

&a210_pd_sdio {
	status = "okay";
};

&a210_pd_dmac {
	status = "okay";
};

&a210_pd_pwm {
	status = "okay";
};

&a210_pd_gmac0 {
	status = "okay";
};

&a210_pd_gmac1 {
	status = "okay";
};

/ {
	zephyr,user {
		power-domains = <&a210_pd_top>,
				<&a210_pd_gpu>,
				<&a210_pd_vo>,
				<&a210_pd_usb>,
				<&a210_pd_pcie0>,
				<&a210_pd_pcie1>,
				<&a210_pd_sata>,
				<&a210_pd_emmc>,
				<&a210_pd_sdio>,
				<&a210_pd_dmac>,
				<&a210_pd_pwm>,
				<&a210_pd_gmac0>,
				<&a210_pd_gmac1>;
		read-only-voltage-domains = <&vdd_cpu &vddm_cpu &vdd_cpu_p &vdd_gpu>;
		/* Vendor AON firmware powers off at the 125 C PVT alarm. */
		zhihe,critical-millicelsius = <125000>;
	};
};
