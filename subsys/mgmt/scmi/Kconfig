config SCMI
	bool

menuconfig SCMI_SERVER
	bool "SCMI platform server"
	select SCMI
	help
	  Serve Base and optional Clock, Reset, Voltage and Performance requests.

if SCMI_SERVER

config SCMI_SERVER_SYSTEM_POWER
	bool "System Power protocol"
	help
	  Serve System Power 2.0 discovery, shutdown and cold reset requests.
	  Warm reset, suspend and graceful notifications are not advertised.

config SCMI_SERVER_SENSOR
	bool "Sensor protocol"
	help
	  Serve Sensor 2.0 scalar descriptions and synchronous readings. Sampling
	  is managed by sensor drivers; trip notifications are not advertised.

config SCMI_SERVER_POWER
	bool "Power Domain protocol"
	help
	  Serve Power Domain 3.0 discovery and synchronous device on/off requests.
	  Platform providers serialize domain transitions and report their state.

config SCMI_SERVER_CLOCK
	bool "Clock protocol"
	help
	  Serve Clock 2.0 discovery, rate enumeration, synchronous rate changes
	  and enable control. Asynchronous requests and notifications are not
	  advertised.

config SCMI_SERVER_RESET
	bool "Reset Domain protocol"
	help
	  Serve Reset Domain 3.0 discovery and synchronous reset requests.
	  Explicit assertion and complete reset sequences use platform callbacks.

config SCMI_SERVER_PERFORMANCE
	bool "Performance protocol"
	help
	  Provide Performance 1.0 discovery, operating point enumeration and
	  synchronous level changes through a platform DVFS backend. Frequency
	  readback comes from hardware; platform limits are fixed. Notifications
	  and fast channels are not advertised.

config SCMI_SERVER_VOLTAGE
	bool "Voltage Domain protocol"
	default y

config SCMI_SERVER_REGULATOR
	bool "Zephyr regulator provider"
	depends on SCMI_SERVER_VOLTAGE && REGULATOR
	default y

endif # SCMI_SERVER

