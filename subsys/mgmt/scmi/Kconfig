config SCMI
	bool

menuconfig SCMI_SERVER
	bool "SCMI platform server"
	select SCMI
	help
	  Serve Base and optional Clock, Reset, Voltage and Performance requests.

if SCMI_SERVER

config SCMI_SERVER_PERFORMANCE
	bool "Performance protocol"
	help
	  Provide Performance 1.0 discovery, operating point enumeration and
	  synchronous level changes through a platform DVFS backend. Frequency
	  readback comes from hardware; platform limits are fixed. Notifications
	  and fast channels are not advertised.

config SCMI_SERVER_VOLTAGE
	bool "Voltage Domain protocol"
	default y

config SCMI_SERVER_REGULATOR
	bool "Zephyr regulator provider"
	depends on SCMI_SERVER_VOLTAGE && REGULATOR
	default y

endif # SCMI_SERVER

