config SCMI
	bool

menuconfig SCMI_SERVER
	bool "SCMI platform server"
	select SCMI
	help
	  Serve Base and optional Clock, Reset, Voltage and Performance requests.

if SCMI_SERVER

config SCMI_SERVER_VOLTAGE
	bool "Voltage Domain protocol"
	default y

config SCMI_SERVER_REGULATOR
	bool "Zephyr regulator provider"
	depends on SCMI_SERVER_VOLTAGE && REGULATOR
	default y

endif # SCMI_SERVER

